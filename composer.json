{
    "name": "foxentry/php-api-client",
    "description": "Foxentry.com PHP API client",
    "keywords": ["Foxentry", "Foxentry.com"],
    "license": "MIT",
    "authors": [
        {
            "name": "Foxentry",
            "email": "info@foxentry.com"
        }
    ],
    "support": {
        "email": "info@foxentry.com"
    },
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.10.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.4"
    },
    "autoload": {
        "psr-4": {
            "Foxentry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Unit\\": "tests/Unit/"
        }
    }
}
